    "One scan is still running. Disk Hog will keep the source window open after cancelling it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Scan läuft noch. Disk Hog lässt das Quellfenster nach dem Abbrechen geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía se está ejecutando un análisis. Disk Hog mantendrá abierta la ventana de origen después de cancelarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une analyse est toujours en cours. Disk Hog gardera la fenêtre source ouverte après l'avoir annulée."
