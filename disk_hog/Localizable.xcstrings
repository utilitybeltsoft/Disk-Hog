    "%lld scans are still running. Disk Hog will keep the source window open after cancelling them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld-Scans werden noch ausgeführt. Disk Hog lässt das Quellfenster nach dem Abbrechen geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los análisis de %lld aún se están ejecutando. Disk Hog mantendrá abierta la ventana de origen después de cancelarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les analyses %lld sont toujours en cours. Disk Hog gardera la fenêtre source ouverte après les avoir annulées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scansioni %lld sono ancora in esecuzione. Disk Hog manterrà aperta la finestra dei sorgenti dopo averli annullati."
          }
        }
      }
    },
    "%lld scans are still running. Quitting Disk Hog will cancel them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld-Scans werden noch ausgeführt. Durch das Beenden von Disk Hog werden diese abgebrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los análisis de %lld aún se están ejecutando. Salir de Disk Hog los cancelará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les analyses %lld sont toujours en cours. Quitter Disk Hog les annulera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scansioni %lld sono ancora in esecuzione. Uscendo da Disk Hog li annullerai."
          }
        }
      }
    },
