    "Showing package contents changes which files and folders are included. Rescan now to apply this setting to existing results." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Anzeige des Paketinhalts ändert sich, welche Dateien und Ordner enthalten sind. Jetzt erneut scannen, um diese Einstellung auf vorhandene Ergebnisse anzuwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar el contenido del paquete cambia qué archivos y carpetas se incluyen. Vuelva a escanear ahora para aplicar esta configuración a los resultados existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'affichage du contenu du package modifie les fichiers et dossiers inclus. Réanalysez maintenant pour appliquer ce paramètre aux résultats existants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La visualizzazione del contenuto del pacchetto modifica i file e le cartelle inclusi. Eseguire nuovamente la scansione ora per applicare questa impostazione ai risultati esistenti."
          }
        }
      }
    },
