    "Space reclaimed is an estimate. APFS snapshots, clones, and filesystem sharing can affect the actual free space." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zurückgewonnene Speicherplatz ist eine Schätzung. APFS-Snapshots, Klone und Dateisystemfreigaben können den tatsächlich freien Speicherplatz beeinflussen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio recuperado es una estimación. Las instantáneas de APFS, los clones y el uso compartido del sistema de archivos pueden afectar al espacio libre real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace récupéré est une estimation. Les instantanés APFS, les clones et le partage du système de fichiers peuvent affecter l’espace réellement libre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio recuperato è una stima. Snapshot APFS, cloni e condivisione del file system possono influire sullo spazio effettivamente libero."
          }
        }
      }
    },
