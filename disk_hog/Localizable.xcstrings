            "value" : "Durch die Anzeige des Paketinhalts ändert sich, welche Dateien und Ordner enthalten sind. Jetzt erneut scannen, um diese Einstellung auf vorhandene Ergebnisse anzuwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
