    },
    "Add files or folders from a scan window to review them before moving them to Finder Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Dateien oder Ordner aus einem Scanfenster hinzu, um sie vor dem Verschieben in den Finder-Papierkorb zu überprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada archivos o carpetas desde una ventana de análisis para revisarlos antes de moverlos a la Papelera del Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des fichiers ou dossiers depuis une fenêtre d’analyse afin de les examiner avant de les déplacer dans la corbeille du Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi file o cartelle da una finestra di scansione per esaminarli prima di spostarli nel Cestino del Finder."
          }
        }
      }
    },
    "Add files or folders from a scan window to review them here before moving them to Finder Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
