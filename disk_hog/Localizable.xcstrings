          }
        }
      }
    },
    "Use arrow keys to select items, Return to zoom in, and Escape to go back. The Files table provides an alternative to spatial navigation." : {
      "comment": "Accessibility text for navigation or selection.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Pfeiltasten Objekte auswählen, mit der Eingabetaste vergrößern und mit Escape zurückgehen. Die Dateitabelle bietet eine Alternative zur räumlichen Navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use las flechas para seleccionar elementos, Retorno para ampliar y Escape para volver. La tabla de archivos ofrece una alternativa a la navegación espacial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les flèches pour sélectionner, Retour pour agrandir et Échap pour revenir. Le tableau des fichiers offre une alternative à la navigation spatiale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le frecce per selezionare elementi, Invio per ingrandire ed Esc per tornare indietro. La tabella dei file offre un’alternativa alla navigazione spaziale."
          }
        }
      }
    },
    "%@, %@, %@" : {
      "comment": "Three accessibility details, separated by pauses. Cleanup: parent path, size, status. Treemap: name, size, path.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@"
          }
        }
      }
    },
