            "value": "Continua"
          }
        }
      }
    },
    "Check Again" : {
      "comment": "Full Disk Access setup. Permission must be enabled by the user in macOS System Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut prüfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a comprobar"
          }
        },
        "fr": {
