    "Estimated reclaimable space can differ from actual free space because of APFS snapshots, clones, and filesystem sharing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der geschätzte zurückgewinnbare Speicher kann wegen APFS-Snapshots, Klonen und Dateisystemfreigaben vom tatsächlich freien Speicher abweichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio recuperable estimado puede diferir del espacio libre real debido a instantáneas de APFS, clones y uso compartido del sistema de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace récupérable estimé peut différer de l’espace réellement libre en raison des instantanés APFS, des clones et du partage du système de fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio recuperabile stimato può differire dallo spazio effettivamente libero a causa di snapshot APFS, cloni e condivisione del file system."
          }
        }
      }
    },
