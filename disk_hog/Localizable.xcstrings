    "Use Disk Hog’s vivid extended palette and optional matching across open windows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie die lebendige erweiterte Palette von Disk Hog und die optionale Farbanpassung zwischen geöffneten Fenstern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use la paleta ampliada y vibrante de Disk Hog y la coincidencia opcional entre ventanas abiertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la palette étendue et vive de Disk Hog, ainsi que la correspondance facultative entre les fenêtres ouvertes."
          }
        },
        "it" : {
