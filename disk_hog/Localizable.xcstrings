{
  "sourceLanguage" : "en",
  "strings" : {
    "Check folder permissions. For protected folders, use Full Disk Access in the Help menu, then reopen Disk Hog." : {
      "comment": "Full Disk Access setup. Permission must be enabled by the user in macOS System Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Ordnerberechtigungen. Verwende für geschützte Ordner „Vollzugriff auf Festplatte“ im Hilfe-Menü und öffne Disk Hog erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba los permisos de la carpeta. Para carpetas protegidas, usa Acceso total al disco en el menú Ayuda y vuelve a abrir Disk Hog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les autorisations du dossier. Pour les dossiers protégés, utilisez Accès complet au disque dans le menu Aide, puis rouvrez Disk Hog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i permessi della cartella. Per le cartelle protette, usa Accesso completo al disco nel menu Aiuto, quindi riapri Disk Hog."
          }
        }
      }
    },
    "Folder access denied" : {
      "comment": "Full Disk Access setup. Permission must be enabled by the user in macOS System Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf Ordner verweigert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a la carpeta denegado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au dossier refusé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla cartella negato"
          }
        }
      }
    },
    "Protected-folder access could not be verified." : {
      "comment": "Full Disk Access setup. Permission must be enabled by the user in macOS System Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf geschützte Ordner konnte nicht bestätigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el acceso a las carpetas protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux dossiers protégés n’a pas pu être vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l’accesso alle cartelle protette."
          }
        }
      }
    },
    "Continue" : {
      "comment": "Full Disk Access setup. Permission must be enabled by the user in macOS System Settings.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortfahren"
          }
        },
        "es": {
