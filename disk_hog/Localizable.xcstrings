          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt des Ordners konnte nicht aufgelistet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo enumerar el contenido de la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu du dossier n’a pas pu être énuméré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile enumerare il contenuto della cartella."
          }
        }
      }
    },
    "The item is no longer available at the expected location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Objekt ist am erwarteten Ort nicht mehr verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elemento ya no está disponible en la ubicación esperada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’élément n’est plus disponible à l’emplacement attendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’elemento non è più disponibile nella posizione prevista."
          }
        }
      }
    },
    "The item may be in use, locked, or protected by macOS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Objekt wird möglicherweise verwendet, ist gesperrt oder durch macOS geschützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el elemento esté en uso, bloqueado o protegido por macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’élément est peut-être utilisé, verrouillé ou protégé par macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’elemento potrebbe essere in uso, bloccato o protetto da macOS."
          }
        }
      }
    },
    "The physical size is the space that a file occupies on a drive. Many applications show the logical size, which is the size of a file's content." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die physische Größe ist der Platz, den eine Datei auf einem Laufwerk einnimmt. Viele Anwendungen zeigen die logische Größe an, also die Größe des Inhalts einer Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño físico es el espacio que ocupa un archivo en una unidad. Muchas aplicaciones muestran el tamaño lógico, que es el tamaño del contenido de un archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille physique est l'espace qu'un fichier occupe sur un lecteur. De nombreuses applications affichent la taille logique, qui correspond à la taille du contenu d'un fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dimensione fisica è lo spazio occupato da un file su un'unità. Molte applicazioni mostrano la dimensione logica, ovvero la dimensione del contenuto di un file."
          }
        }
      }
    },
    "This item is on a network volume. Do you want to delete it permanently?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Element befindet sich auf einem Netzwerkvolume. Möchten Sie es dauerhaft löschen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este elemento está en un volumen de red. ¿Quieres eliminarlo permanentemente?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément se trouve sur un volume réseau. Voulez-vous le supprimer définitivement ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elemento si trova su un volume di rete. Vuoi eliminarlo definitivamente?"
          }
        }
      }
    },
    "This scan is still running. Closing the window will cancel it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Scan läuft noch. Durch Schließen des Fensters wird der Vorgang abgebrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este análisis aún se está ejecutando. Cerrar la ventana lo cancelará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette analyse est toujours en cours. La fermeture de la fenêtre l'annulera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa scansione è ancora in esecuzione. La chiusura della finestra la annullerà."
          }
        }
      }
    },
    "This volume is read-only, so Disk Hog cannot %@ this item." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Volume ist schreibgeschützt, daher kann Disk Hog dieses Element nicht %1$@." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Este volumen es de solo lectura, por lo que Disk Hog no puede %1$@ este elemento." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce volume est en lecture seule, donc Disk Hog ne peut pas %1$@ cet élément." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Questo volume è di sola lettura, quindi Disk Hog non può %1$@ questo elemento." } }
