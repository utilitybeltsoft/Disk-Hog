      }
    },
    "Folder sizes include contents. Parent and child totals overlap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnergrößen enthalten den Inhalt. Die Summen über- und untergeordneter Ordner überschneiden sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tamaños de las carpetas incluyen su contenido. Los totales de carpetas superiores y subordinadas se solapan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille des dossiers inclut leur contenu. Les totaux des dossiers parents et enfants se chevauchent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dimensioni delle cartelle includono il contenuto. I totali delle cartelle superiori e subordinate si sovrappongono."
          }
        }
      }
    },
    "Some items couldn’t be scanned. Sizes marked with a ≥ may be larger; Unknown does not mean empty. View Scan Issues.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Objekte konnten nicht gescannt werden. Mit ≥ markierte Größen können größer sein; „Unbekannt“ bedeutet nicht leer. Siehe Scan-Probleme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron analizar algunos elementos. Los tamaños marcados con ≥ pueden ser mayores; «Desconocido» no significa vacío. Consulta los problemas del análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments n’ont pas pu être analysés. Les tailles marquées d’un ≥ peuvent être supérieures ; « Inconnu » ne signifie pas vide. Consultez les problèmes d’analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile analizzare alcuni elementi. Le dimensioni contrassegnate con ≥ potrebbero essere maggiori; «Sconosciuto» non significa vuoto. Consulta i problemi di scansione."
          }
        }
      }
    },
    "Files are read over the scan interval, not all at one instant. Changes made afterward are not monitored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden während des Scan-Zeitraums gelesen, nicht alle gleichzeitig. Spätere Änderungen werden nicht überwacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se leen durante el análisis, no todos a la vez. No se supervisan los cambios posteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont lus pendant la durée de l’analyse, pas tous au même instant. Les modifications ultérieures ne sont pas surveillées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vengono letti durante la scansione, non tutti nello stesso istante. Le modifiche successive non vengono monitorate."
          }
        }
      }
    },
    "Not updated automatically": {
      "localizations": {
