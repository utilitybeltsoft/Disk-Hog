    "Other used includes space outside the completed scan tree, such as protected files, snapshots, and sibling system volumes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere genutzte Bereiche umfassen Speicherplatz außerhalb des abgeschlossenen Scan-Baums, z. B. geschützte Dateien, Snapshots und Geschwistersystem-Volumes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros utilizados incluyen espacio fuera del árbol de análisis completo, como archivos protegidos, instantáneas y volúmenes de sistemas hermanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres espaces utilisés incluent l'espace en dehors de l'arborescence d'analyse terminée, comme les fichiers protégés, les instantanés et les volumes système frères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altro utilizzo include lo spazio esterno all'albero di scansione completato, come file protetti, istantanee e volumi di sistema di pari livello."
          }
        }
      }
    },
    "Out of sync: this scan hides package contents; the current setting shows them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht synchron: Dieser Scan verbirgt den Paketinhalt; Die aktuelle Einstellung zeigt sie an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera de sincronización: este análisis oculta el contenido del paquete; la configuración actual los muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désynchronisé : cette analyse masque le contenu du package ; le paramètre actuel les affiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sincronizzato: questa scansione nasconde il contenuto del pacchetto; l'impostazione corrente li mostra."
          }
        }
      }
    },
    "Out of sync: this scan shows package contents; the current setting hides them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht synchron: Dieser Scan zeigt den Paketinhalt; Die aktuelle Einstellung verbirgt sie."
          }
