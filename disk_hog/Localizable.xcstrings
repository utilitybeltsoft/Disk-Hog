          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada archivos o carpetas desde una ventana de análisis para revisarlos aquí antes de moverlos a la Papelera del Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des fichiers ou dossiers depuis une fenêtre d’analyse afin de les examiner ici avant de les déplacer dans la corbeille du Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
