    "Hiding package contents changes which files and folders are included. Rescan now to apply this setting to existing results." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Ausblenden von Paketinhalten ändert sich, welche Dateien und Ordner enthalten sind. Jetzt erneut scannen, um diese Einstellung auf vorhandene Ergebnisse anzuwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar el contenido del paquete cambia qué archivos y carpetas se incluyen. Vuelva a escanear ahora para aplicar esta configuración a los resultados existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le masquage du contenu du package modifie les fichiers et dossiers inclus. Réanalysez maintenant pour appliquer ce paramètre aux résultats existants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondere il contenuto del pacchetto modifica i file e le cartelle inclusi. Eseguire nuovamente la scansione ora per applicare questa impostazione ai risultati esistenti."
          }
        }
      }
    },
