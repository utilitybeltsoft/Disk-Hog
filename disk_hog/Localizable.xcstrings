    "Scan issues will be available after this scan finishes. An empty list does not yet mean every item was scanned successfully.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan-Probleme werden nach Abschluss dieses Scans angezeigt. Eine leere Liste bedeutet noch nicht, dass alle Objekte erfolgreich gescannt wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los problemas del análisis estarán disponibles cuando termine. Una lista vacía aún no significa que todos los elementos se hayan analizado correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les problèmes d’analyse seront disponibles une fois cette analyse terminée. Une liste vide ne signifie pas encore que tous les éléments ont été analysés correctement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I problemi di scansione saranno disponibili al termine di questa scansione. Un elenco vuoto non significa ancora che tutti gli elementi siano stati analizzati correttamente."
          }
        }
      }
    },
