    "Remaining used includes files not yet added to the scan tree and space outside it. The value is recalculated as scanning progresses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verbleibende Nutzung umfasst Dateien, die noch nicht zum Scan-Baum hinzugefügt wurden, sowie den Speicherplatz außerhalb davon. Der Wert wird im Verlauf des Scanvorgangs neu berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resto utilizado incluye archivos que aún no se han agregado al árbol de escaneo y espacio fuera de él. El valor se vuelve a calcular a medida que avanza el escaneo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers utilisés restant incluent les fichiers non encore ajoutés à l'arborescence d'analyse et l'espace en dehors de celle-ci. La valeur est recalculée au fur et à mesure de la progression de l'analyse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utilizzo rimanente include i file non ancora aggiunti all'albero di scansione e lo spazio al di fuori di esso. Il valore viene ricalcolato man mano che la scansione avanza."
          }
        }
      }
    },
